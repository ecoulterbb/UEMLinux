<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.blackberry.enterprise</groupId>
    <artifactId>uem.catalog.cloud</artifactId>
    <version>43.32.0</version>
    <packaging>pom</packaging>

    <properties>
        <target.directory>./target</target.directory>
        <bundle.directory>${target.directory}/bundle</bundle.directory>
        <coreui.directory>${target.directory}/CoreUILinux</coreui.directory>
        <snapins.directory>${target.directory}/snapins</snapins.directory>
        <resource.rename.directory>${target.directory}/resources-to-rename</resource.rename.directory>
        <uos.manifest.directory>${target.directory}/uos-manifest</uos.manifest.directory>
        <uos.manifest.source>catalog/cloud</uos.manifest.source>
        <marketVersion>12.23.0</marketVersion>
        <marketVersionSuffix></marketVersionSuffix>
    </properties>

    <repositories>
        <repository>
            <id>ebu-snapshots</id>
            <name>ebu-snapshots</name>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <checksumPolicy>fail</checksumPolicy>
            </snapshots>
            <url>http://enterprise-nexus.rim.net/nexus/content/repositories/ebu-snapshots</url>
        </repository>
        <repository>
            <id>ebu-releases</id>
            <name>ebu-release</name>
            <releases>
                <enabled>true</enabled>
                <checksumPolicy>fail</checksumPolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <url>http://enterprise-nexus.rim.net/nexus/content/repositories/ebu-releases</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>ebu-external-group</id>
            <name>ebu-external-group</name>
            <url>http://enterprise-nexus.rim.net/nexus/content/groups/ebu-external-group</url>
            <releases>
                <enabled>true</enabled>
                <checksumPolicy>fail</checksumPolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>ebu-tools</id>
            <name>ebu-tools</name>
            <url>http://enterprise-nexus.rim.net/nexus/content/repositories/ebu-tools</url>
            <releases>
                <enabled>true</enabled>
                <checksumPolicy>fail</checksumPolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.rim.platform.mdm</groupId>
                <artifactId>mdm</artifactId>
                <type>pom</type>
                <scope>test</scope>
                <version>44.37.0</version>
            </dependency>
            <dependency>
                <groupId>com.rim.platform.mdm</groupId>
                <artifactId>mdm.core.plugin.test</artifactId>
                <scope>test</scope>
                <version>44.37.0</version>
            </dependency>
            <dependency>
                <groupId>com.rim.platform.mdm</groupId>
                <artifactId>mdm.test.tools</artifactId>
                <scope>test</scope>
                <version>44.37.0</version>
            </dependency>
            <dependency>
                <groupId>com.rim.platform.mdm</groupId>
                <artifactId>mdm.test.tools</artifactId>
                <type>test-jar</type>
                <scope>test</scope>
                <version>44.37.0</version>
            </dependency>
            <dependency>
                <groupId>com.rim.platform.dal</groupId>
                <artifactId>mdm.tomcat.startup</artifactId>
                <scope>test</scope>
                <version>45.32.0</version>
            </dependency>
            <dependency>
                <groupId>com.rim.platform.mdm.config-tools</groupId>
                <artifactId>mdm.deployment.tools</artifactId>
                <scope>test</scope>
                <version>44.32.0</version>
            </dependency>
            <dependency>
                <groupId>com.blackberry.enterprise.cdk</groupId>
                <artifactId>enterprise.deployment.parametertools</artifactId>
                <classifier>jar-with-dependencies</classifier>
                <scope>test</scope>
                <version>[6.12,6.9999)</version>
            </dependency>
            <dependency>
                <groupId>com.blackberry.enterprise.cdk</groupId>
                <artifactId>enterprise.deployment.cdk-cloud-configs</artifactId>
                <classifier>zip</classifier>
                <type>zip</type>
                <scope>test</scope>
                <version>[6.12,6.9999)</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.rim.bep.coreui</groupId>
            <artifactId>bep.coreui</artifactId>
            <version>43.32.0</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>com.rim.bep.coreui</groupId>
            <artifactId>bep.coreui.linux</artifactId>
            <version>43.32.0</version>
            <type>tar</type>
            <!-- avoid downloading transitive dependencies
                 which are never required for POM or TAR -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.mdm.deployment-tools</groupId>
            <artifactId>mdm.deployment.bes12pods.template</artifactId>
            <version>43.34.0</version>
            <classifier>zip</classifier>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.dal</groupId>
            <artifactId>mdm.dal.deployment</artifactId>
            <version>45.32.0</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.rim.bep.coreui</groupId>
            <artifactId>bep.common.uos.base</artifactId>
            <version>43.32.0</version>
            <classifier>zip</classifier>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.rim.mdm.niap.manifest</groupId>
            <artifactId>FPManifest</artifactId>
            <version>1.0</version>
            <type>mf</type>
        </dependency>
        <dependency>
            <groupId>com.rim.mdm.niap.manifest</groupId>
            <artifactId>FPManifest</artifactId>
            <version>1.0</version>
            <type>sf</type>
        </dependency>
        <dependency>
            <groupId>com.rim.bep.coreui</groupId>
            <artifactId>bep.cloud.uos.base</artifactId>
            <version>43.32.0</version>
            <classifier>tar</classifier>
            <type>tar</type>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.mdm.config-tools</groupId>
            <artifactId>mdm.config.tools.uos.manifest</artifactId>
            <version>44.32.0</version>
            <classifier>zip</classifier>
            <type>zip</type>
        </dependency>
        <!-- P2e clients for Core. -->
        <dependency>
            <groupId>com.rim.enterprise.p2e.release</groupId>
            <artifactId>sys.p2evpn</artifactId>
            <version>1.4.0.234</version>
            <classifier>signed</classifier>
            <type>bar</type>
        </dependency>
        <dependency>
            <groupId>com.rim.enterprise.p2e.release</groupId>
            <artifactId>p2e-android</artifactId>
            <version>1.21.0.868</version>
            <classifier>release-appstore</classifier>
            <type>apk</type>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.dal</groupId>
            <artifactId>mdm.deployment.database</artifactId>
            <version>45.32.0</version>
            <type>tar</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.mdm.config-tools</groupId>
            <artifactId>mdm.deployment.configtemplates</artifactId>
            <version>44.32.0</version>
            <classifier>zip</classifier>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.blackberry.snapin.bb2fa.release</groupId>
            <artifactId>bb2fa</artifactId>
            <version>1.4.0.89</version>
            <type>zip</type>
            <classifier>jakarta</classifier>
        </dependency>
        <dependency>
            <groupId>com.blackberry.snapin.bems.release</groupId>
            <artifactId>bems</artifactId>
            <version>1.10.0.99</version>
            <type>zip</type>
            <classifier>jakarta</classifier>
        </dependency>
        <dependency>
            <groupId>com.blackberry.eid.snapin.release</groupId>
            <artifactId>eid</artifactId>
            <version>1.21.0.132</version>
            <type>zip</type>
            <classifier>jakarta</classifier>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.mdm.snapins.workspaces.release</groupId>
            <artifactId>workspaces-snapin</artifactId>
            <version>4.10.2.703</version>
            <classifier>cloud-jakarta</classifier>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.blackberry.snapin.orgconnect.release</groupId>
            <artifactId>orgconnect</artifactId>
            <version>1.1.0.153</version>
            <type>zip</type>
            <classifier>jakarta</classifier>
        </dependency>
        <dependency>
            <groupId>com.blackberry.snapin.bemsdocs.release</groupId>
            <artifactId>bemsdocs</artifactId>
            <version>1.2.0.32</version>
            <type>zip</type>
            <classifier>jakarta</classifier>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.mdm.snapins.bbmp.release</groupId>
            <artifactId>bbmp</artifactId>
            <version>1.6.0.235</version>
            <classifier>jakarta</classifier>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.mdm.public.api</groupId>
            <artifactId>mdm.diagnostic</artifactId>
            <version>44.38.0</version>
            <classifier>zip</classifier>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.rim.platform.dal</groupId>
            <artifactId>mdm.azure.blob.delete</artifactId>
            <version>45.32.0</version>
            <classifier>bin</classifier>
            <type>zip</type>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Make sure this instruction file for deployment config build does not install/deploy to the maven repo -->
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>xml-maven-plugin</artifactId>
                    <version>1.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Generate the cloud Bundle -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-artifacts-for-processing</id>
                        <phase>generate-sources</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${resource.rename.directory}</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.rim.platform.mdm.config-tools</groupId>
                                    <artifactId>mdm.deployment.configtemplates</artifactId>
                                    <classifier>zip</classifier>
                                    <type>zip</type>
                                    <includes>common/uos*,common/default_cloud_product.yml,common/default_fedramp_product.yml</includes>
                                </artifactItem>
                                <!-- Files for generating the uos-manifest.xml -->
                                <artifactItem>
                                    <groupId>com.rim.platform.mdm.config-tools</groupId>
                                    <artifactId>mdm.config.tools.uos.manifest</artifactId>
                                    <type>zip</type>
                                    <classifier>zip</classifier>
                                    <outputDirectory>${uos.manifest.directory}</outputDirectory>
                                    <includes>${uos.manifest.source}/**</includes>
                                </artifactItem>
                                <!-- End uos-manifest.xml files -->
                            </artifactItems>
                        </configuration>
                    </execution>

                    <!-- Generate the UOS Manifest XML -->
                    <execution>
                        <id>copy-bep-pom</id>
                        <phase>generate-sources</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.rim.bep.coreui</groupId>
                                    <artifactId>bep.coreui</artifactId>
                                    <type>pom</type>
                                    <destFileName>bep-pom.xml</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${uos.manifest.directory}</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>

                    <!--Artifacts that we can unpack directly into the bundle -->
                    <execution>
                        <id>unpack-artifacts-to-bundle</id>
                        <phase>prepare-package</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${coreui.directory}</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.rim.bep.coreui</groupId>
                                    <artifactId>bep.common.uos.base</artifactId>
                                    <type>zip</type>
                                    <classifier>zip</classifier>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.bep.coreui</groupId>
                                    <artifactId>bep.cloud.uos.base</artifactId>
                                    <type>tar</type>
                                    <classifier>tar</classifier>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.platform.dal</groupId>
                                    <artifactId>mdm.dal.deployment</artifactId>
                                    <type>jar</type>
                                    <includes>common-settings/DB.properties,hosted/azure.properties</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.bep.coreui</groupId>
                                    <artifactId>bep.coreui.linux</artifactId>
                                    <type>tar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.platform.mdm.deployment-tools</groupId>
                                    <artifactId>mdm.deployment.bes12pods.template</artifactId>
                                    <classifier>zip</classifier>
                                    <type>zip</type>
                                    <outputDirectory>${coreui.directory}/pods</outputDirectory>
                                    <includes>cloud/**,*.jar</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.platform.dal</groupId>
                                    <artifactId>mdm.deployment.database</artifactId>
                                    <type>tar</type>
                                    <outputDirectory>${target.directory}</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.platform.dal</groupId>
                                    <artifactId>mdm.azure.blob.delete</artifactId>
                                    <type>zip</type>
                                    <classifier>bin</classifier>
                                    <outputDirectory>${target.directory}/tools</outputDirectory>
                                    <excludes>**/*.bat</excludes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>

                    <!--Artifacts that we can copy directly into the bundle -->
                    <execution>
                        <id>copy-artifacts-to-bundle</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${coreui.directory}</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.rim.enterprise.p2e.release</groupId>
                                    <artifactId>p2e-android</artifactId>
                                    <classifier>release-appstore</classifier>
                                    <type>apk</type>
                                    <outputDirectory>${coreui.directory}/etc/besngHome/Core/system.app/noactivation</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.blackberry.snapin.bb2fa.release</groupId>
                                    <artifactId>bb2fa</artifactId>
                                    <type>zip</type>
                                    <classifier>jakarta</classifier>
                                    <outputDirectory>${snapins.directory}/pods/cloud</outputDirectory>
                                    <destFileName>com.blackberry.snapin.bb2fa.snapin.zip</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.blackberry.snapin.bems.release</groupId>
                                    <artifactId>bems</artifactId>
                                    <type>zip</type>
                                    <classifier>jakarta</classifier>
                                    <outputDirectory>${snapins.directory}/pods/cloud</outputDirectory>
                                    <destFileName>com.blackberry.snapin.bems.snapin.zip</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.blackberry.eid.snapin.release</groupId>
                                    <artifactId>eid</artifactId>
                                    <type>zip</type>
                                    <classifier>jakarta</classifier>
                                    <outputDirectory>${snapins.directory}/pods/cloud</outputDirectory>
                                    <destFileName>com.blackberry.eid.snapin.snapin.zip</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.blackberry.snapin.orgconnect.release</groupId>
                                    <artifactId>orgconnect</artifactId>
                                    <type>zip</type>
                                    <classifier>jakarta</classifier>
                                    <outputDirectory>${snapins.directory}/pods/cloud</outputDirectory>
                                    <destFileName>com.blackberry.snapin.orgconnect.zip</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.blackberry.snapin.bemsdocs.release</groupId>
                                    <artifactId>bemsdocs</artifactId>
                                    <classifier>jakarta</classifier>
                                    <type>zip</type>
                                    <outputDirectory>${snapins.directory}/pods/cloud</outputDirectory>
                                    <destFileName>com.blackberry.snapin.bemsdocs.zip</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.platform.mdm.snapins.bbmp.release</groupId>
                                    <artifactId>bbmp</artifactId>
                                    <classifier>jakarta</classifier>
                                    <type>zip</type>
                                    <outputDirectory>${snapins.directory}/pods/cloud</outputDirectory>
                                    <destFileName>com.blackberry.snapin.bbmp.zip</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.platform.mdm.snapins.workspaces.release</groupId>
                                    <artifactId>workspaces-snapin</artifactId>
                                    <classifier>cloud-jakarta</classifier>
                                    <type>zip</type>
                                    <outputDirectory>${snapins.directory}/pods/cloud</outputDirectory>
                                    <destFileName>workspaces-snapin.cloud.zip</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.platform.mdm.public.api</groupId>
                                    <artifactId>mdm.diagnostic</artifactId>
                                    <classifier>zip</classifier>
                                    <type>zip</type>
                                    <outputDirectory>${snapins.directory}/pods/cloud</outputDirectory>
                                    <destFileName>mdm.diagnostic.zip</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.mdm.niap.manifest</groupId>
                                    <artifactId>FPManifest</artifactId>
                                    <type>mf</type>
                                    <outputDirectory>${coreui.directory}/common-settings</outputDirectory>
                                    <destFileName>FPManifest.mf</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.rim.mdm.niap.manifest</groupId>
                                    <artifactId>FPManifest</artifactId>
                                    <type>sf</type>
                                    <outputDirectory>${coreui.directory}/common-settings</outputDirectory>
                                    <destFileName>FPManifest.sf</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--Generate uos-manifest xml files-->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>xml-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>process-sources</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>transform</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <id>generate-manifest-files</id>
                    <transformationSets>
                        <transformationSet>
                            <dir>.</dir>
                            <outputDir>${uos.manifest.directory}</outputDir>
                            <includes>
                                <include>cloud.xml</include>
                            </includes>
                            <stylesheet>${uos.manifest.directory}/${uos.manifest.source}/uos-manifest.xsl</stylesheet>
                            <parameters>
                                <parameter>
                                    <name>market-version</name>
                                    <value>${marketVersion}</value>
                                </parameter>
                                <parameter>
                                    <name>market-version-suffix</name>
                                    <value>${marketVersionSuffix}</value>
                                </parameter>
                                <parameter>
                                    <name>project-version</name>
                                    <value>43.32.0</value>
                                </parameter>
                                <parameter>
                                    <name>bundle-version</name>
                                    <value>${bundleVersion}</value>
                                </parameter>
                            </parameters>
                            <fileMappers>
                                <fileMapper implementation="org.codehaus.plexus.components.io.filemappers.RegExpFileMapper">
                                    <pattern>cloud.xml</pattern>
                                    <replacement>uos-manifest.xml</replacement>
                                </fileMapper>
                            </fileMappers>
                        </transformationSet>
                        <transformationSet>
                            <dir>.</dir>
                            <outputDir>${target.directory}</outputDir>
                            <includes>
                                <include>cloud.xml</include>
                            </includes>
                            <stylesheet>${uos.manifest.directory}/${uos.manifest.source}/manifest.xsl</stylesheet>
                            <parameters>
                                <parameter>
                                    <name>market-version</name>
                                    <value>${marketVersion}</value>
                                </parameter>
                                <parameter>
                                    <name>project-version</name>
                                    <value>43.32.0</value>
                                </parameter>
                                <parameter>
                                    <name>market-version-suffix</name>
                                    <value>${marketVersionSuffix}</value>
                                </parameter>
                                <parameter>
                                    <name>bundle-version</name>
                                    <value>${bundleVersion}</value>
                                </parameter>
                            </parameters>
                            <fileMappers>
                                <fileMapper implementation="org.codehaus.plexus.components.io.filemappers.RegExpFileMapper">
                                    <pattern>cloud.xml</pattern>
                                    <replacement>manifest.xml</replacement>
                                </fileMapper>
                            </fileMappers>
                        </transformationSet>
                    </transformationSets>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>net.sf.saxon</groupId>
                        <artifactId>saxon</artifactId>
                        <version>8.7</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Final processing and packaging -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-resources-configtemplates</id>
                        <phase>package</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${bundle.directory}/env/common</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${resource.rename.directory}/common</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <inherited>true</inherited>
                <executions>
                    <execution>
                        <id>copy-uos-manifest-xml-file</id>
                        <phase>prepare-package</phase>
                        <inherited>false</inherited>
                        <configuration>
